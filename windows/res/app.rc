// The exe's resources: the app icon, the tray icon's glyph, and the version info.
#pragma code_page(65001)

#include <winresrc.h>

#include "resource.h"
#include "version.h"

// Drawn by make-icon.ps1 into build/, which build.ps1 passes to rc with /I.
IDI_APP ICON "app.ico"
IDI_TRAY ICON "tray.ico"

// Version info: Task Manager, Startup apps and the Windows 11 toast show the app by these names.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SIDETONE_VERSION_MAJOR, SIDETONE_VERSION_MINOR, SIDETONE_VERSION_PATCH, 0
 PRODUCTVERSION SIDETONE_VERSION_MAJOR, SIDETONE_VERSION_MINOR, SIDETONE_VERSION_PATCH, 0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Giancarlo Dalle Mole"
            VALUE "FileDescription",  "Sidetone Off"
            VALUE "FileVersion",      SIDETONE_VERSION_STRING
            VALUE "InternalName",     "SidetoneOff"
            VALUE "OriginalFilename", "SidetoneOff.exe"
            VALUE "ProductName",      "Sidetone Off"
            VALUE "ProductVersion",   SIDETONE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
